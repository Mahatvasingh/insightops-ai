# InsightOps AI Configuration Example

PROJECT_NAME="InsightOps AI"
API_V1_STR="/api/v1"
SECRET_KEY="c8a9f3e4b1d720516b7e820c4519fa9012e3456789abcdef0123456789abcdef"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo & System Control
DEMO_MODE=true
SCRAPER_MODE=demo  # demo | live

# Databases & Persistence
DATABASE_URL="sqlite+aiosqlite:///./insightops.db"
SYNC_DATABASE_URL="sqlite:///./insightops.db"
SQLITE_CHECKPOINT_DB="./checkpointer.db"

# LLM Provider Configuration
LLM_PROVIDER=mock  # mock | openai | gemini
OPENAI_API_KEY=""
GEMINI_API_KEY=""
DEFAULT_LLM_MODEL="gpt-4o-mini"
LLM_TOKEN_BUDGET=50000

# CORS Allowed Origins (comma-separated or JSON list)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Anomaly Thresholds
CRITICAL_PCT_THRESHOLD=15.0
HIGH_PCT_THRESHOLD=5.0

# Rate Limits
RATE_LIMIT_DEFAULT="100/minute"
RATE_LIMIT_AUTH="10/minute"
RATE_LIMIT_AGENT_RUN="10/minute"
